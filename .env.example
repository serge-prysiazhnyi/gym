NODE_ENV=development

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gym
DATABASE_URL=postgres://**:**@localhost:5432/gym

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=3600

# LLM: "mock" needs nothing else; "openai-compatible" works with OpenRouter,
# OpenAI, Groq, DeepSeek or Ollama by changing LLM_BASE_URL + LLM_MODEL.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Optional: retried once on a transient failure of LLM_MODEL
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=1500
# Set to false if the model doesn't support response_format: json_schema
LLM_STRUCTURED_OUTPUT=true
